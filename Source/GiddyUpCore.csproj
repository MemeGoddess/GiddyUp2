<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Product>Giddy-Up</Product>
        <!-- AssemblyVersion/FileVersion are read from About.xml's modVersion at build time, see ModVersionFromAbout -->
        <!-- Was <Version>, which also set the DLL's FileVersion/InformationalVersion to the game version -->
        <RimWorldVersion>1.7</RimWorldVersion>
        <Copyright>Roolo, Owlchemist, dav9670, Meme Goddess, Phonicmas</Copyright>
        <Company>Owlchemist</Company>
        <Deterministic>true</Deterministic>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Nullable>enable</Nullable>
    	<GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <OutputPath>..\$(RimWorldVersion)\Assemblies</OutputPath>
        <DefineConstants>TRACE;NDEBUG</DefineConstants>
        <WarningLevel>4</WarningLevel>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>Embedded</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <OutputPath>..\$(RimWorldVersion)\Assemblies</OutputPath>
        <DefineConstants>TRACE;DEBUG;NETFRAMEWORK;NET48;</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldVersion).*-*" />
        <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" />
    </ItemGroup>
    <ItemGroup>
        <Publicize Include="Assembly-CSharp;UnityEngine.IMGUIModule;UnityEngine.CoreModule" />
    </ItemGroup>
    <Target Name="ModVersionFromAbout" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
        <XmlPeek XmlInputPath="..\About\About.xml" Query="/ModMetaData/modVersion/text()">
            <Output TaskParameter="Result" PropertyName="ModVersion" />
        </XmlPeek>
        <!-- Without this an unreadable About.xml silently builds as 1.0.0.0 -->
        <Error Condition="'$(ModVersion)' == ''" Text="modVersion not found in About/About.xml" />
        <PropertyGroup>
            <AssemblyVersion>$(ModVersion)</AssemblyVersion>
            <FileVersion>$(ModVersion)</FileVersion>
            <InformationalVersion>$(ModVersion)</InformationalVersion>
        </PropertyGroup>
    </Target>
</Project>