<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<HediffDef>
		<defName>GU_TF_FlightFatigue</defName>
		<label>flight fatigue</label>
		<description>This creature recently carried a rider through the air and needs to rest its wings before it can take flight again.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.75, 0.85, 1)</defaultLabelColor>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<scenarioCanAdd>false</scenarioCanAdd>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>5000~5000</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
	</HediffDef>

</Defs>
